#!/usr/bin/env python3
import argparse
import json
import os
import re
import shlex
import subprocess
import sys
from collections import defaultdict
from pathlib import Path


KITTY_SOCKET = "unix:@shortcut-help-kitty"
SHELL_NAMES = {
    "bash",
    "dash",
    "fish",
    "sh",
    "zsh",
}
KITTY_HELPER_NAMES = {
    "kitten",
}
UNICODE_ESCAPE = re.compile(r"\\U([0-9A-Fa-f]{4,8})|\\u([0-9A-Fa-f]{4})")


def run_text(command):
    try:
        return subprocess.check_output(
            command,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=1,
        )
    except (subprocess.SubprocessError, OSError):
        return None


def run_json(command):
    output = run_text(command)
    if output is None:
        return None
    try:
        return json.loads(output)
    except json.JSONDecodeError:
        return None


def normalize_name(name):
    name = os.path.basename(name or "")
    if name.startswith("."):
        name = name[1:]
    for suffix in ("-wrapped", ".wrapped"):
        if name.endswith(suffix):
            name = name[: -len(suffix)]
    return name


def decode_unicode_escapes(text):
    def replace(match):
        value = match.group(1) or match.group(2)
        return chr(int(value, 16))

    return UNICODE_ESCAPE.sub(replace, text)


def process_names(pid):
    names = set()
    try:
        exe = os.readlink(f"/proc/{pid}/exe")
        names.add(os.path.basename(exe))
        names.add(normalize_name(exe))
    except OSError:
        pass

    try:
        comm = Path(f"/proc/{pid}/comm").read_text().strip()
        names.add(comm)
        names.add(normalize_name(comm))
    except OSError:
        pass

    return {name for name in names if name}


def process_table():
    processes = {}
    children = defaultdict(list)

    proc_root = Path("/proc")
    for entry in proc_root.iterdir():
        if not entry.name.isdigit():
            continue

        pid = int(entry.name)
        try:
            stat = (entry / "stat").read_text()
            rparen = stat.rfind(")")
            fields = stat[rparen + 2 :].split()
            ppid = int(fields[1])
        except (OSError, IndexError, ValueError):
            continue

        names = process_names(pid)
        processes[pid] = names
        children[ppid].append(pid)

    return processes, children


def descendant_names(root_pid):
    processes, children = process_table()
    found = set()
    stack = list(children.get(root_pid, []))

    while stack:
        pid = stack.pop()
        names = processes.get(pid, set())
        if not names.intersection(KITTY_HELPER_NAMES):
            found.update(names)
        stack.extend(children.get(pid, []))

    return {name for name in found if name not in SHELL_NAMES}


def active_window():
    window = run_json(["hyprctl", "activewindow", "-j"])
    if not isinstance(window, dict):
        return {}
    return window


def window_under_cursor():
    cursor = run_json(["hyprctl", "cursorpos", "-j"])
    clients = run_json(["hyprctl", "clients", "-j"])
    if not isinstance(cursor, dict) or not isinstance(clients, list):
        return active_window()

    x = cursor.get("x")
    y = cursor.get("y")
    if not isinstance(x, (int, float)) or not isinstance(y, (int, float)):
        return active_window()

    candidates = []
    for window in clients:
        at = window.get("at")
        size = window.get("size")
        if (
            not window.get("mapped", False)
            or window.get("hidden", False)
            or window.get("visible") is False
            or not isinstance(at, list)
            or len(at) != 2
            or not isinstance(size, list)
            or len(size) != 2
        ):
            continue

        left, top = at
        width, height = size
        if left <= x < left + width and top <= y < top + height:
            candidates.append(window)

    if not candidates:
        return active_window()

    def focus_order(window):
        value = window.get("focusHistoryID")
        return value if isinstance(value, int) and value >= 0 else sys.maxsize

    return min(candidates, key=focus_order)


def command_names(command):
    if isinstance(command, str):
        try:
            command = shlex.split(command)
        except ValueError:
            command = command.split()

    if not isinstance(command, list) or not command:
        return set()

    executable = command[0]
    if not isinstance(executable, str):
        return set()

    return {os.path.basename(executable), normalize_name(executable)}


def active_tmux_pane_names(terminal_pid):
    try:
        terminal_tty = os.readlink(f"/proc/{terminal_pid}/fd/0")
    except OSError:
        return set()

    clients = run_text(
        ["tmux", "list-clients", "-F", "#{client_tty}|#{session_id}"]
    )
    if clients is None:
        return set()

    session_ids = set()
    for line in clients.splitlines():
        client_tty, separator, session_id = line.partition("|")
        if separator and client_tty == terminal_tty:
            session_ids.add(session_id)

    if not session_ids:
        return set()

    panes = run_text(
        [
            "tmux",
            "list-panes",
            "-a",
            "-F",
            "#{session_id}|#{window_active}|#{pane_active}|#{pane_current_command}",
        ]
    )
    if panes is None:
        return set()

    names = set()
    for line in panes.splitlines():
        fields = line.split("|", maxsplit=3)
        if (
            len(fields) == 4
            and fields[0] in session_ids
            and fields[1] == "1"
            and fields[2] == "1"
        ):
            command = fields[3]
            names.update(command_names(command))

    return names


def kitty_titles(os_window):
    titles = set()
    for tab in os_window.get("tabs", []):
        if tab.get("title"):
            titles.add(tab["title"])
        for window in tab.get("windows", []):
            if window.get("title"):
                titles.add(window["title"])
    return titles


def active_kitty_process_names(hyprland_window):
    listing = run_json(["kitty", "@", "--to", KITTY_SOCKET, "ls"])
    if not isinstance(listing, list):
        return set()

    title = hyprland_window.get("title")
    matching_windows = [
        os_window for os_window in listing if title and title in kitty_titles(os_window)
    ]
    if not matching_windows:
        matching_windows = [
            os_window
            for os_window in listing
            if os_window.get("is_focused") or os_window.get("is_active")
        ]

    names = set()
    for os_window in matching_windows:
        for tab in os_window.get("tabs", []):
            if not (tab.get("is_focused") or tab.get("is_active")):
                continue

            active_history = tab.get("active_window_history") or []
            active_window_id = active_history[0] if active_history else None

            for window in tab.get("windows", []):
                window_active = bool(
                    window.get("is_focused")
                    or window.get("is_active")
                    or (active_window_id is not None and window.get("id") == active_window_id)
                )
                if not window_active:
                    continue

                window_names = set()
                window_names.update(command_names(window.get("last_reported_cmdline")))
                window_names.update(command_names(window.get("cmdline")))
                for process in window.get("foreground_processes", []):
                    window_names.update(command_names(process.get("cmdline")))
                    if "pid" in process:
                        window_names.update(process_names(process["pid"]))
                if "pid" in window:
                    window_names.update(process_names(window["pid"]))
                    meaningful_names = window_names - SHELL_NAMES - KITTY_HELPER_NAMES
                    if not meaningful_names:
                        window_names.update(descendant_names(window["pid"]))
                    if "tmux" in window_names:
                        window_names.update(active_tmux_pane_names(window["pid"]))
                names.update(window_names)

    return {name for name in names if name and name not in SHELL_NAMES}


def match_any(values, detected):
    return bool(set(values or []).intersection(detected))


def format_section(rule_name, rule):
    title = decode_unicode_escapes(rule.get("title") or rule_name)
    shortcuts = [
        decode_unicode_escapes(line) for line in rule.get("shortcuts", []) if line
    ]
    if not shortcuts:
        return ""
    return "\n".join([f"{title} shortcuts", *shortcuts])


def matching_sections(config, window):
    pid = window.get("pid")
    app_names = set()
    if isinstance(pid, int):
        app_names.update(process_names(pid))
    app_names.update(
        normalize_name(value)
        for value in (
            window.get("class"),
            window.get("initialClass"),
            window.get("xdgTag"),
        )
        if value
    )
    app_classes = {
        value
        for value in (
            window.get("class"),
            window.get("initialClass"),
            window.get("xdgTag"),
        )
        if value
    }
    app_titles = {
        value
        for value in (
            window.get("title"),
            window.get("initialTitle"),
            window.get("xdgDescription"),
        )
        if value
    }

    kitty_names = set()
    is_kitty = "kitty" in app_names or "kitty" in app_classes
    if is_kitty:
        kitty_names = active_kitty_process_names(window)
        kitty_names.update(command_names(window.get("title")))

    sections = []
    for rule_name, rule in (config.get("rules") or {}).items():
        match = rule.get("match") or {}
        matched = False

        matched = matched or match_any(match.get("executables"), app_names)
        matched = matched or match_any(match.get("classes"), app_classes)
        matched = matched or match_any(match.get("titles"), app_titles)
        matched = matched or (
            is_kitty
            and match_any(match.get("terminalForegroundExecutables"), kitty_names)
        )

        if matched:
            section = format_section(rule_name, rule)
            if section:
                sections.append(section)

    return sections


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--config", required=True)
    parser.add_argument("--global-help")
    args = parser.parse_args()

    try:
        config = json.loads(Path(args.config).read_text())
    except (OSError, json.JSONDecodeError) as error:
        print(f"Unable to read shortcut help config: {error}", file=sys.stderr)
        return 1

    output = []
    if args.global_help:
        try:
            global_help = decode_unicode_escapes(Path(args.global_help).read_text().strip())
            if global_help:
                output.append(global_help)
        except OSError as error:
            print(f"Unable to read global shortcut help: {error}", file=sys.stderr)
            return 1

    sections = matching_sections(config, window_under_cursor())
    if sections:
        if output:
            output.append("----------------")
        output.extend(sections)

    print("\n\n".join(output))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
