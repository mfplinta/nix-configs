#!/usr/bin/env python3

import json
import math
import subprocess

scales = [1.0, 1.25, 1.5, 2.0]

monitors = json.loads(subprocess.check_output(["hyprctl", "-j", "monitors"]))
if not monitors:
    raise SystemExit("no active monitors")

current_scale = monitors[0]["scale"]
try:
    scale_idx = next(
        index
        for index, scale in enumerate(scales)
        if math.isclose(scale, current_scale, abs_tol=0.001)
    )
    next_scale = scales[(scale_idx + 1) % len(scales)]
except StopIteration:
    next_scale = scales[0]

monitors.sort(
    key=lambda monitor: monitor["x"],
    reverse=next_scale < current_scale,
)

for monitor in monitors:
    position = (
        f'{round(monitor["x"] * current_scale / next_scale)}x'
        f'{round(monitor["y"] * current_scale / next_scale)}'
    )
    mode = (
        f'{monitor["width"]}x{monitor["height"]}'
        f'@{monitor["refreshRate"]:.5f}'
    )
    spec = {
        "output": monitor["name"],
        "mode": mode,
        "position": position,
        "scale": next_scale,
        "transform": monitor["transform"],
    }
    fields = []
    for key, value in spec.items():
        if isinstance(value, str):
            value = json.dumps(value, ensure_ascii=False)
        elif isinstance(value, float):
            value = repr(value)
        fields.append(f"{key} = {value}")

    subprocess.run(
        ["hyprctl", "eval", f'hl.monitor({{{", ".join(fields)}}})'],
        check=True,
        stdout=subprocess.DEVNULL,
    )

subprocess.run(["pkill", "-USR2", "waybar"], check=False)

print(next_scale)
